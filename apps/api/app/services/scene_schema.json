{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chyron shop scene spec",
  "description": "Grid-based practice room. Mirrors the checks in app/services/validator.py (R1-R7). Passed to Gemini as response_json_schema; the validator still runs on every output.",
  "type": "object",
  "required": ["room", "layout", "task", "support", "events"],
  "properties": {
    "room": {
      "type": "object",
      "required": ["w", "h", "entrance"],
      "properties": {
        "w": { "type": "integer", "description": "room width in grid cells (x), between 6 and 24" },
        "h": { "type": "integer", "description": "room depth in grid cells (y), between 6 and 24; y = h-1 is the south wall" },
        "entrance": {
          "type": "object",
          "required": ["wall", "cells"],
          "properties": {
            "wall": { "type": "string", "description": "entrance is always on south wall: 'S'" },
            "cells": {
              "type": "array",
              "description": "[x, y] cells on south edge where each y = room.h - 1",
              "items": {
                "type": "array",
                "items": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "array",
      "description": "layout objects: shelves, exactly one counter, and decor",
      "items": {
        "type": "object",
        "required": ["id", "asset", "cell", "size"],
        "properties": {
          "id": { "type": "string", "description": "unique snake_case id, e.g. shelf1, counter" },
          "asset": { "type": "string", "description": "asset type: shelf, counter, fridge, basket_stand, plant, bench, table" },
          "cell": {
            "type": "array",
            "description": "[x, y] top-left cell coordinates",
            "items": { "type": "integer" }
          },
          "size": {
            "type": "array",
            "description": "[w, h] in cells, e.g. [2, 1]",
            "items": { "type": "integer" }
          },
          "items": {
            "type": "array",
            "description": "items with sku and price in rupees",
            "items": {
              "type": "object",
              "required": ["sku", "price"],
              "properties": {
                "sku": { "type": "string", "description": "item sku, e.g. milk" },
                "price": { "type": "integer", "description": "price in rupees" }
              }
            }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["required", "budget", "time_limit_s", "difficulty", "rules", "what_ifs"],
      "properties": {
        "required": {
          "type": "array",
          "description": "skus the learner must buy; each must be on some shelf",
          "items": { "type": "string" }
        },
        "budget": { "type": "integer", "description": "budget in rupees covering cheapest required basket" },
        "time_limit_s": { "type": "integer", "description": "time limit in seconds, e.g. 180" },
        "difficulty": { "type": "string", "description": "Emerging, Developing, or Secure" },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "what_ifs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "support": {
      "type": "object",
      "required": ["A", "B", "C"],
      "description": "A = calmest (volume<=40, density<=2); B (volume<=60, density<=3); C (volume<=80, density<=5)",
      "properties": {
        "A": {
          "type": "object",
          "required": ["prompt", "density", "volume"],
          "properties": {
            "prompt": { "type": "integer", "description": "prompt level 0-3" },
            "density": { "type": "integer", "description": "density 0-2" },
            "volume": { "type": "integer", "description": "volume 0-40" }
          }
        },
        "B": {
          "type": "object",
          "required": ["prompt", "density", "volume"],
          "properties": {
            "prompt": { "type": "integer", "description": "prompt level 0-3" },
            "density": { "type": "integer", "description": "density 0-3" },
            "volume": { "type": "integer", "description": "volume 0-60" }
          }
        },
        "C": {
          "type": "object",
          "required": ["prompt", "density", "volume"],
          "properties": {
            "prompt": { "type": "integer", "description": "prompt level 0-3" },
            "density": { "type": "integer", "description": "density 0-5" },
            "volume": { "type": "integer", "description": "volume 0-80" }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "scenario events and triggers",
      "items": {
        "type": "object",
        "required": ["trigger", "target"],
        "properties": {
          "trigger": { "type": "string", "description": "trigger type: enter, pickup, checkout, timer, what_if, prompt" },
          "target": { "type": "string", "description": "layout object id or 'shopkeeper'" }
        }
      }
    }
  }
}
