# Local development. Copy to .env (gitignored). On Cloud Run these come from
# Secret Manager and --set-env-vars (see infra/gcp/deploy.sh).

# Database: SQLite for quick local runs; Cloud SQL for PostgreSQL in the cloud.
DATABASE_URL=sqlite:///./chernyx.db
# DATABASE_URL=postgresql+psycopg2://chyron:PASSWORD@/chyron?host=/cloudsql/PROJECT:asia-south1:chyron-pg

# JWT (Secret Manager: chyron-jwt-secret)
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI provider: gemini | mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Or Vertex AI instead of an AI Studio key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=asia-south1

# Confirm every model id in AI Studio on Day 1 morning; Google renames models often.
GEMINI_PLANNER_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_PREVIEW_IMAGES=off        # off | inline (data URLs, demo) | gcs (gs://$BUCKET/previews, served at /api/v1/previews)
GEMMA_MODEL=gemma-4-26b-a4b-it
EDIT_PROVIDER=gemini             # gemma = private edits (see .agents/skills/gemma-private-edits)

# Demo safety: cache = replay saved Gemini responses with no network
DEMO_MODE=live
DEMO_CACHE_DIR=./demo_cache

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Web build: same-origin on Firebase Hosting
# VITE_API_BASE_URL=/api/v1
