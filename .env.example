# Environment variables for local development
# Copy this file to .env and adjust values as needed.

# Database URL – default uses PostgreSQL in Docker compose.
# For quick local testing you can use SQLite:
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cheranyx

# JWT configuration (change the secret in production)
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI provider configuration (Phase 2)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
